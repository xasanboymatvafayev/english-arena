# ---------- GENERAL ----------
ENVIRONMENT=development
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30
APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# ---------- DATABASE ----------
# Local PostgreSQL:
DATABASE_URL=postgresql+psycopg://arena:arena_dev_password@127.0.0.1:5432/english_arena
# Railway provides DATABASE_URL automatically. It looks like:
# postgresql://postgres:password@containers-us-west-1.railway.app:6543/railway
# The app converts postgres:// / postgresql:// to postgresql+psycopg:// automatically.

# ---------- EMAILJS (server-side only) ----------
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_API_URL=https://api.emailjs.com/api/v1.0/email/send
INVITATION_EXPIRE_DAYS=7

# ---------- FILES ----------
UPLOAD_DIR=uploads
MAX_IMAGE_MB=4
MAX_BOOK_MB=40
MAX_ASSIGNMENT_MB=15
